<<tab-promedio-bilateral-multilateral, echo=FALSE, results=tex>>=
if (requireNamespace("xtable", quietly = TRUE) && !is.null(tabla_promedio_bilateral_multilateral)) {
  print(xtable::xtable(tabla_promedio_bilateral_multilateral,
