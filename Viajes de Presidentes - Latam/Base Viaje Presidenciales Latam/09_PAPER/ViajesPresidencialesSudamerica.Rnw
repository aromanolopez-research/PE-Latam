\section{Datos y metodolog\'ia}
% TODO. Describir:
%   - Universo: 12 paises de Sudamerica, 1994-2025 (2026 se agrega despues).
%   - Fuente primaria: dataset COLT \citep{moyerWhenHeadsGovernment2025}, cruzado y
%     corregido/ampliado con investigacion propia (ver 00_CODEBOOK/CODEBOOK.txt
%     para el esquema completo de 76 columnas y la convencion de IDs
%     PELATAM-<ISO3>-<n> para filas agregadas que COLT no tenia).
%   - Categorizacion derivada Bilateral/Multilateral/Otro (no nativa de COLT;
%     ver comentario en 08_ANALISIS_R/graficos_exploratorios.R seccion 6).
%   - Regla de inclusion: solo se cuentan viajes cuyo inicio Y fin caen
%     dentro del mandato presidencial (ver 08_ANALISIS_R/graficos_exploratorios.R,
%     seccion 1.2c, y las fechas de mandato verificadas en
%     09_PAPER/mandatos_presidenciales.csv).
%   - Limitaciones conocidas: cobertura desigual por pais/periodo, ver
%     05_BITACORA/PENDIENTES_VERIFICACION.txt.

\section{Resultados}

\subsection{Descriptivos generales}

<<tab-ficha-general, echo=FALSE, results=tex>>=
# La ficha general (antes Figura 1, una imagen) pasa a Cuadro.
if (requireNamespace("xtable", quietly = TRUE) && !is.null(ficha_general)) {
  print(xtable::xtable(ficha_general,
                        caption = "Ficha general de la base: total de viajes, per\\'iodo cubierto, cantidad de pa\\'ises y mandatarios, y participaci\\'on Bilateral/Multilateral/Otro.",
                        label = "tab:ficha-general"),
        include.rownames = FALSE, caption.placement = "top")
} else {
  cat("% Falta 00a_ficha_general.csv (correr graficos_exploratorios.R) o el paquete 'xtable'.\n")
}
@

<<tab-totales-pais, echo=FALSE, results=tex>>=
if (requireNamespace("xtable", quietly = TRUE)) {
  print(xtable::xtable(viajes_totales_pais,
                        caption = "Total de viajes registrados por pais (1994-2025)",
                        label = "tab:totales-pais"),
        include.rownames = FALSE, caption.placement = "top")
} else {
  cat("% Instalar el paquete 'xtable' para renderizar esta tabla automaticamente.\n")
}
@

% Todas las figuras de esta seccion se referencian directamente desde
% 08_ANALISIS_R/outputs/ (generadas por graficos_exploratorios.R) y NO se
% regeneran aca. Si corriste una version mas nueva del script de R, alcanza
% con recompilar este .Rnw para que las figuras se actualicen solas -no
% hace falta tocar nada de esta seccion salvo que cambien los nombres de
% archivo.

\begin{figure}[H]
  \centering
  \includegraphics[width=0.9\textwidth]{../08_ANALISIS_R/outputs/00c_viajes_totales_por_mandatario.png}
  \caption{Total de viajes registrados por mandatario, 1994-2025, limitado a mandatarios con m\'as de 50 viajes (la tabla completa, sin ese recorte, est\'a en \texttt{00c\_viajes\_totales\_por\_mandatario.csv}). Entre par\'entesis, el per\'iodo de mandato (dos rangos separados por punto y coma para mandatarios con mandatos no consecutivos). Solo se cuentan viajes realizados durante el mandato (ver Datos y metodolog\'ia).}
  \label{fig:totales-mandatario}
\end{figure}

<<tab-resumen-estadisticos, echo=FALSE, results=tex>>=
# De imagen a Cuadro. Se agrega la columna Unidad_n_obs para aclarar que las
# dos primeras filas cuentan combinaciones pais-anio y la fila de duracion
# cuenta viajes individuales -son unidades de observacion distintas, por eso
# n_obs difiere tanto entre filas.
if (requireNamespace("xtable", quietly = TRUE) && !is.null(resumen_estadisticos)) {
  print(xtable::xtable(resumen_estadisticos,
                        caption = "Estad\\'isticos descriptivos (media, desv\\'io, m\\'inimo, m\\'aximo) de viajes por pa\\'is-a\\~no y de la duraci\\'on de los viajes.",
                        label = "tab:resumen-estadisticos"),
        include.rownames = FALSE, caption.placement = "top")
} else {
  cat("% Falta 00d_resumen_estadisticos_descriptivos.csv o el paquete 'xtable'.\n")
}
@

% Nota: la base solo incluye viajes realizados DURANTE el mandato (tanto el
% inicio como el fin del viaje deben caer dentro del periodo presidencial;
% ver 08_ANALISIS_R/graficos_exploratorios.R, seccion 1.2c). Por esta regla
% se excluyo el viaje de Jair Bolsonaro a Estados Unidos (30-dic-2022 a
% 30-mar-2023): arranco 2 dias antes de terminar su mandato pero se extendio
% casi 3 meses despues de dejar el cargo. El maximo actual de "Duracion del
% viaje" (71 dias) corresponde a Hugo Chavez, Venezuela a Cuba (10-dic-2012
% a 18-feb-2013) por tratamiento medico -siguio siendo presidente en
% ejercicio durante todo ese periodo, por eso el viaje si queda incluido.

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/12_tipo_actividad_viajes.png}
  \caption{Tipo de actividad incluida en los viajes presidenciales (categor\'ias no excluyentes; cf. \citep{charnockPresidentialTravelEisenhower2009} sobre viajes presidenciales de EE.\,UU.).}
  \label{fig:tipo-actividad}
\end{figure}

\subsection{Evoluci\'on temporal}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/01_viajes_por_anio.png}
  \caption{Cantidad de viajes presidenciales por a\~no, Sudam\'erica 1994-2025.}
  \label{fig:viajes-por-anio}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=\textwidth]{../08_ANALISIS_R/outputs/01b_viajes_por_anio_por_pais.png}
  \caption{Cantidad de viajes por a\~no, desagregado por pa\'is. La l\'inea punteada marca el promedio anual de cada pa\'is.}
  \label{fig:viajes-por-anio-pais}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/11_viajes_por_anio_de_mandato.png}
  \caption{Promedio de viajes por a\~no de mandato (a\~no 1, a\~no 2, ...), normalizado por la cantidad de mandatos que efectivamente llegaron a cada a\~no dentro de la ventana 1994-2025. Permite comparar presidentes con mandatos de distinta duraci\'on y detectar patrones de ``luna de miel''/``pato rengo'' (cf. \citep{ostranderPresidentsAbroadPolitics2018}). La etiqueta sobre cada barra indica cu\'antos mandatos aportan datos a ese a\~no.}
  \label{fig:viajes-por-anio-mandato}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.9\textwidth]{../08_ANALISIS_R/outputs/02_regiones_por_periodo.png}
  \caption{Prioridad regional de los viajes presidenciales, por per\'iodo (bloques de 5 a\~nos). Etiquetas de dato para Am\'erica Latina y el Caribe, Europa y Norteam\'erica.}
  \label{fig:regiones-periodo}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.9\textwidth]{../08_ANALISIS_R/outputs/02b_regiones_por_anio_area.png}
  \caption{Prioridad regional de los viajes presidenciales, por a\~no.}
  \label{fig:regiones-anio}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/03_duracion_por_anio.png}
  \caption{Duraci\'on promedio de los viajes presidenciales, por a\~no.}
  \label{fig:duracion-anio}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.9\textwidth]{../08_ANALISIS_R/outputs/03c_viajes_y_duracion_combinado.png}
  \caption{Cantidad de viajes (barras) y duraci\'on promedio en d\'ias (l\'inea), por a\~no.}
  \label{fig:viajes-duracion-combinado}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.9\textwidth]{../08_ANALISIS_R/outputs/04_categoria_visita_por_anio.png}
  \caption{Participaci\'on de Bilateral / Multilateral / Otro, por a\~no. ``Otro'' = sin reuni\'on registrada con el anfitri\'on ni asistencia a un evento multilateral.}
  \label{fig:categoria-anio}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/04b_categoria_visita_absoluto.png}
  \caption{Cantidad absoluta de viajes por categor\'ia (Bilateral/Multilateral/Otro), por a\~no.}
  \label{fig:categoria-absoluto}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/13_auge_caida_multilateralismo.png}
  \caption{Participaci\'on de viajes multilaterales por a\~no, con la fundaci\'on de UNASUR (2008) y su crisis/vaciamiento posterior (desde 2018) marcados como referencia (cf. \citep{nolteSummitsPlainsCrisis2021, barrosCrisisSouthAmerican2021}).}
  \label{fig:auge-caida-multilateralismo}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/08_estacionalidad_mensual.png}
  \caption{Estacionalidad: mes de inicio de los viajes, todos los mandatarios y a\~nos juntos.}
  \label{fig:estacionalidad}
\end{figure}

\subsection{Comparaci\'on entre pa\'ises}

% El destino favorito por presidente pasa del grafico facetado de 90+
% paneles (dificil de leer) a un Cuadro largo (longtable, pagina a pagina)
% con el pais, el mandatario y su periodo entre parentesis, el destino
% favorito y la cantidad de viajes a ese destino.
<<tab-destino-favorito, echo=FALSE, results=tex>>=
if (requireNamespace("xtable", quietly = TRUE) && !is.null(tabla_destino_favorito)) {
  print(xtable::xtable(tabla_destino_favorito,
                        caption = "Destino favorito de cada mandatario (pa\\'is m\\'as visitado durante su mandato), con el per\\'iodo de mandato entre par\\'entesis.",
                        label = "tab:destino-favorito"),
        include.rownames = FALSE, caption.placement = "top",
        tabular.environment = "longtable", floating = FALSE)
} else {
  cat("% Falta 05c_destino_favorito_tabla.csv o el paquete 'xtable'.\n")
}
@

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/06_primeros_destinos_frecuencia.png}
  \caption{Pa\'is elegido como primer viaje al exterior del mandato, cu\'antas veces se repite cada uno (ver \citep{ostranderPresidentsAbroadPolitics2018}, Tabla 1, para el equivalente en EE.\,UU.).}
  \label{fig:primeros-destinos}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/06b_evolucion_top3_primeros_destinos.png}
  \caption{Evoluci\'on 1994-2025 de la cantidad de viajes (todas las categor\'ias) a Estados Unidos, Brasil y Argentina -los 3 pa\'ises m\'as elegidos como primer destino (Figura~\ref{fig:primeros-destinos}).}
  \label{fig:evolucion-top3-primeros-destinos}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/14_sesgo_vecino_inmediato.png}
  \caption{Porcentaje de TODOS los viajes (no s\'olo el primero) que van a un pa\'is con frontera terrestre, por pa\'is de origen. Ostrander \& Rider (2018) encuentran que 7 de 10 presidentes de EE.\,UU. eligen un vecino como primer destino; ac\'a se prueba si el patr\'on se sostiene para el conjunto completo de viajes en Sudam\'erica (ver \citep{ostranderPresidentsAbroadPolitics2018}).}
  \label{fig:sesgo-vecino-inmediato}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/09a_ranking_destinos_bilaterales.png}
  \caption{Los 20 destinos bilaterales m\'as visitados (viajes con reuni\'on registrada con el anfitri\'on).}
  \label{fig:ranking-bilateral}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/09a2_evolucion_bilateral_bra_arg_cuba.png}
  \caption{Evoluci\'on 1994-2025 de los viajes bilaterales a Brasil, Argentina y Cuba.}
  \label{fig:evolucion-bilateral-bra-arg-cuba}
\end{figure}

\begin{figure}[H]
  \centering
  \includegraphics[width=0.85\textwidth]{../08_ANALISIS_R/outputs/09b_ranking_destinos_multilaterales.png}
