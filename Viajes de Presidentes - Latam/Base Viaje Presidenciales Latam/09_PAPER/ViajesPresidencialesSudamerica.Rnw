\end{abstract}

<<setup, echo=FALSE, results=hide>>=
# ------------------------------------------------------------------------
# Chunk de setup: NO vuelve a correr todo graficos_exploratorios.R. Lee
# los CSV de resumen y da por hechas las figuras PNG ya generadas ahi.
# Si todavia no corriste ese script, hacelo antes de knitear este archivo.
# ------------------------------------------------------------------------
RUTA_OUTPUTS <- file.path("..", "08_ANALISIS_R", "outputs")

leer_resumen <- function(archivo) {
  read.csv(file.path(RUTA_OUTPUTS, archivo), stringsAsFactors = FALSE)
}

fix_na_cuadro <- function(df) {
  df[] <- lapply(df, function(x) { x[is.na(x)] <- ""; x })
  df
}

# NOTA: esta variable se llamaba antes "ficha_general" pero en realidad leia
# el CSV de totales por pais (00b) -nombre enganioso, corregido aca.
viajes_totales_pais  <- leer_resumen("00b_viajes_totales_por_pais.csv")
# "Ficha general" real: 7 indicadores (total de viajes, periodo, cantidad de
# paises/mandatarios, % bilateral/multilateral/otro) -> Cuadro 1 del paper.
ficha_general         <- tryCatch(leer_resumen("00a_ficha_general.csv"), error = function(e) NULL)
diferencias_colt      <- tryCatch(leer_resumen("00a2_diferencias_colt.csv"), error = function(e) NULL)
resumen_estadisticos <- tryCatch(leer_resumen("00d_resumen_estadisticos_descriptivos.csv"), error = function(e) NULL)
top5_destinos        <- tryCatch(leer_resumen("05_top5_destinos_por_presidente.csv"), error = function(e) NULL)
tabla_destino_favorito <- tryCatch(leer_resumen("05c_destino_favorito_tabla.csv"), error = function(e) NULL)
tabla_perfil_regional <- tryCatch(leer_resumen("16_perfil_regional_por_presidente.csv"), error = function(e) NULL)
primera_visita        <- tryCatch(leer_resumen("06_primera_visita_por_presidente.csv"), error = function(e) NULL)
tabla_correlacion_ideologia <- tryCatch(leer_resumen("18b_correlacion_ideologia_viajes_intralatam.csv"), error = function(e) NULL)
tabla_correlacion_destinos  <- tryCatch(leer_resumen("18g_correlacion_ideologia_usa_china_europa.csv"), error = function(e) NULL)
tabla_indice_homofilia      <- tryCatch(leer_resumen("19b_indice_homofilia_total.csv"), error = function(e) NULL)
tabla_correlacion_vecino    <- tryCatch(leer_resumen("14b_correlacion_vecino_tiempo.csv"), error = function(e) NULL)

total_viajes <- sum(viajes_totales_pais$n_viajes)
total_paises <- nrow(viajes_totales_pais)
@

